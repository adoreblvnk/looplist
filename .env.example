# Live Services (Required)
# Gemini 3.6 Flash via @ai-sdk/google
GOOGLE_GENERATIVE_AI_API_KEY=your_google_generative_ai_api_key_here

# Vercel Blob private store token
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# eBay Boundary Status
# Live credentials are optional; when absent, LoopList uses a deterministic eBay-compatible adapter mode.
EBAY_ENVIRONMENT=sandbox
EBAY_CLIENT_ID=your_ebay_client_id_here
EBAY_CLIENT_SECRET=your_ebay_client_secret_here
EBAY_REFRESH_TOKEN=your_ebay_refresh_token_here
EBAY_RU_NAME=your_ebay_ru_name_here
EBAY_MARKETPLACE_ID=EBAY_US

# Preconfigured eBay seller policies (optional for sandbox API connector)
EBAY_MERCHANT_LOCATION_KEY=
EBAY_PAYMENT_POLICY_ID=
EBAY_FULFILLMENT_POLICY_ID=
EBAY_RETURN_POLICY_ID=
